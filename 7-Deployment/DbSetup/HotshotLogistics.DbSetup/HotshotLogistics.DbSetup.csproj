<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <UserSecretsId>5e715bfe-daf4-4203-9587-57d214ae5719</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <!--
      Microsoft.Data.SqlClient resolves System.Security.Cryptography.Pkcs 9.0.x, whose
      published advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) fail the build under
      TreatWarningsAsErrors. Pin the serviced 10.0.x line that ship with .NET 10.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
