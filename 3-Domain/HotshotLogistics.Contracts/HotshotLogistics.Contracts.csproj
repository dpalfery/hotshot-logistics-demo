<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!--
      Microsoft.Data.SqlClient resolves System.Security.Cryptography.Pkcs 9.0.x, whose
      published advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) fail the build under
      TreatWarningsAsErrors. Pin the serviced 10.0.x line that ship with .NET 10.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\0-Base\HotshotLogistics.Core\HotshotLogistics.Core.csproj" />
    <ProjectReference Include="..\HotshotLogistics.Domain\HotshotLogistics.Domain.csproj" />
  </ItemGroup>

</Project>
