<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <UserSecretsId>a562df9b-74fa-48b9-adfc-379cdc5868a7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.SqlServer" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\0-Base\HotshotLogistics.Core\HotshotLogistics.Core.csproj" />
    <ProjectReference Include="..\..\..\1-Presentation\HotshotLogistics.Api\HotshotLogistics.Api.csproj" />
    <ProjectReference Include="..\..\..\2-Application\HotshotLogistics.Application\HotshotLogistics.Application.csproj" />
    <ProjectReference Include="..\..\..\3-Domain\HotshotLogistics.Contracts\HotshotLogistics.Contracts.csproj" />
    <ProjectReference Include="..\..\..\3-Domain\HotshotLogistics.Domain\HotshotLogistics.Domain.csproj" />
    <ProjectReference Include="..\..\..\4-Persistence\HotshotLogistics.Data\HotshotLogistics.Data.csproj" />
    <!--
      Kept referenced so the migration runner is built alongside these tests, but off the global
      namespace: on net10.0 a top-level-statements project exports a public global Program class,
      which makes the unqualified Program in the WebApplicationFactory fixtures ambiguous
      (CS0433) against the identical public Program that HotshotLogistics.Api exports. No type
      from this project is used here, so an alias costs nothing.
    -->
    <ProjectReference Include="..\..\..\4-Persistence\MigrationRunner\MigrationRunner.csproj"
                      Aliases="migrationrunner" />
  </ItemGroup>

</Project>
